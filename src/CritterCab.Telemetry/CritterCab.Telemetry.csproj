<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <PackageReference Include="WolverineFx" />
    <PackageReference Include="WolverineFx.RuntimeCompilation" />
    <PackageReference Include="WolverineFx.Http" />
    <PackageReference Include="WolverineFx.Http.FluentValidation" />
    <PackageReference Include="WolverineFx.FluentValidation" />
    <PackageReference Include="WolverineFx.Marten" />
    <PackageReference Include="WolverineFx.Grpc" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" />
  </ItemGroup>

  <!-- gRPC proto-first codegen toolchain. Grpc.Tools is build-only (PrivateAssets
       in Directory.Packages.props); Google.Protobuf and Grpc.AspNetCore are the
       runtime halves the generated code binds against. -->
  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Grpc.Tools" />
    <PackageReference Include="Google.Protobuf" />
  </ItemGroup>

  <!-- The .proto is the contract (ADR-009), so it lives in the repo-root protos/
       tree shared across services rather than inside this project, and is compiled
       in from there. ProtoRoot points at that tree so the proto's own package path
       (crittercab/telemetry/v1) resolves for imports. GrpcServices="Server"
       generates TelemetryService.TelemetryServiceBase — the abstract base the
       [WolverineGrpcService] stub derives from — plus the LocationPing and
       LocationIngestAck message classes in namespace CritterCab.Telemetry.V1.
       First codegen-behind-a-proto in the repo. -->
  <ItemGroup>
    <Protobuf Include="..\..\protos\crittercab\telemetry\v1\report_locations.proto"
              ProtoRoot="..\..\protos"
              Link="protos\crittercab\telemetry\v1\report_locations.proto"
              GrpcServices="Server" />
  </ItemGroup>

</Project>
